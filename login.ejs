<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - StayBook</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="logo"><a href="/">StayBook</a></div>
  </nav>

  <div class="form-container">
    <h2>Log In</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="error-box">
        <ul>
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <label for="email">Email</label>
      <input type="text" id="email" name="email" value="<%= oldEmail %>" placeholder="name@example.com">

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Your password">

      <button type="submit">Log In</button>
    </form>

    <p class="switch-link">Don't have an account? <a href="/signup">Sign up</a></p>
  </div>
</body>
</html>
